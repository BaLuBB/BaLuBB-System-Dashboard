{
  "name": "balubb-system-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "System-Dashboard für Team: CPU, RAM, Disk, Netzwerk, Prozesse, Sensoren, GPU",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test server/server.test.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "systeminformation": "^5.23.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11"
  }
}
